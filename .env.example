# === Multi-mailbox (preferred): MAIL_ACCOUNTS as a JSON array ===
# Each tool takes an "account" param (the id). DEFAULT_MAIL_ACCOUNT picks the
# default (else the first). IMAP user/pass fall back to the SMTP ones if omitted.
# MAIL_ACCOUNTS='[
#   {"id":"marco","label":"marco@example.com",
#    "imap":{"host":"imap.ionos.de","port":993,"secure":true,"user":"marco@example.com","pass":"pw"},
#    "smtp":{"host":"smtp.ionos.de","port":587,"secure":false,"user":"marco@example.com","pass":"pw","from":"marco@example.com"}},
#   {"id":"tonline","label":"name@t-online.de",
#    "imap":{"host":"secureimap.t-online.de","port":993,"secure":true,"user":"name@t-online.de","pass":"pw"},
#    "smtp":{"host":"securesmtp.t-online.de","port":465,"secure":true,"user":"name@t-online.de","pass":"pw","from":"name@t-online.de"}}
# ]'
# DEFAULT_MAIL_ACCOUNT=marco

# === Legacy single-mailbox mode (used only if MAIL_ACCOUNTS is unset) ===
# === Sending (SMTP) — optional if IMAP is set ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false        # true für Port 465 (SSL), false für STARTTLS
SMTP_USER=user@example.com
SMTP_PASS=your-password
SMTP_FROM=user@example.com

# === Reading (IMAP) — optional if SMTP is set ===
# Falls IMAP_USER/IMAP_PASS leer bleiben, werden SMTP_USER/SMTP_PASS genutzt.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true         # true für Port 993 (SSL), false für STARTTLS/143
IMAP_USER=user@example.com
IMAP_PASS=your-password

# Mind. eines von SMTP_* / IMAP_* muss gesetzt sein.
# Provider-Beispiele:
#   IONOS   : SMTP smtp.ionos.de:587 (STARTTLS) | IMAP imap.ionos.de:993 (SSL)
#   T-Online: SMTP securesmtp.t-online.de:465 (SSL, SMTP_SECURE=true)
#             IMAP secureimap.t-online.de:993 (SSL) — „Passwort für E-Mail-Programme" nötig

# Traefik
MCP_DOMAIN=mail-mcp.yourdomain.com

# MCP Auth
MCP_API_KEY=your-secret-api-key

# Authelia OIDC (für Claude.ai OAuth – optional)
OIDC_CLIENT_ID=mail-mcp
OIDC_CLIENT_SECRET=your-oidc-secret

# OAuth-Discovery für Claude.ai (nötig, damit der claude.ai-Connector den
# Login-Flow findet). Beide setzen -> /.well-known/oauth-* werden öffentlich
# ausgeliefert und 401 trägt einen WWW-Authenticate-Header.
OAUTH_PUBLIC_BASE_URL=https://mail-mcp.yourdomain.com   # exakt die MCP-URL
OIDC_ISSUER_URL=https://authelia.yourdomain.com          # Authelia-Basis-URL
