# === Sending (SMTP) — optional if IMAP is set ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false        # true für Port 465 (SSL), false für STARTTLS
SMTP_USER=user@example.com
SMTP_PASS=your-password
SMTP_FROM=user@example.com

# === Reading (IMAP) — optional if SMTP is set ===
# Falls IMAP_USER/IMAP_PASS leer bleiben, werden SMTP_USER/SMTP_PASS genutzt.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true         # true für Port 993 (SSL), false für STARTTLS/143
IMAP_USER=user@example.com
IMAP_PASS=your-password

# Mind. eines von SMTP_* / IMAP_* muss gesetzt sein.
# Provider-Beispiele:
#   IONOS   : SMTP smtp.ionos.de:587 (STARTTLS) | IMAP imap.ionos.de:993 (SSL)
#   T-Online: SMTP securesmtp.t-online.de:465 (SSL, SMTP_SECURE=true)
#             IMAP secureimap.t-online.de:993 (SSL) — „Passwort für E-Mail-Programme" nötig

# Traefik
MCP_DOMAIN=mail-mcp.yourdomain.com

# MCP Auth
MCP_API_KEY=your-secret-api-key

# Authelia OIDC (für Claude.ai OAuth – optional)
OIDC_CLIENT_ID=mail-mcp
OIDC_CLIENT_SECRET=your-oidc-secret
